# Database
DATABASE_URL="postgresql://user:password@localhost:5432/electrical_lab"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# API
API_PORT=3000
API_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# AWS (optional for local development)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="electrical-lab-assets"

# LRS (optional)
LRS_ENDPOINT=""
LRS_USERNAME=""
LRS_PASSWORD=""

# Sentry (optional)
SENTRY_DSN=""

# Environment
NODE_ENV="development"
